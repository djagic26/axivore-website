# Copy to .env.local for local dev, or set directly in Vercel → Project → Settings → Environment Variables.
# Both are public (NEXT_PUBLIC_*) by design — GA4 Measurement IDs and Meta Pixel IDs are not secrets.
# Neither tracker loads until a visitor accepts the cookie banner (see lib/ConsentContext.tsx).

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
